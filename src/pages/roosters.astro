---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header'
import Footer from '../components/Footer.astro'
import logo from '../assets/ubv-the-eagles-logo.png'

const trainings = [
  {
    team: 'Heren 1',
    sessions: [
      { day: 'Dinsdag', time: '20:30 – 22:00', location: 'Sporthal Lunetten · Zaal 1' },
      { day: 'Donderdag', time: '20:30 – 22:00', location: 'Sporthal Lunetten · Zaal 2' },
    ],
  },
  {
    team: 'Heren 2',
    sessions: [{ day: 'Woensdag', time: '20:00 – 21:30', location: 'Sporthal Lunetten · Zaal 2' }],
  },
  {
    team: 'Heren 3',
    sessions: [{ day: 'Donderdag', time: '19:30 – 21:00', location: 'Sporthal Lunetten · Zaal 1' }],
  },
  {
    team: 'Heren 4',
    sessions: [{ day: 'Donderdag', time: '21:00 – 22:30', location: 'Sporthal Lunetten · Zaal 1' }],
  },
]

const duties = [
  { date: '26 okt', time: '20:00', match: 'Heren 1 – Riverside Giants', timer: 'Joris van Dijk', scorer: 'Sem Bakker', referees: 'Mark de Wit · Tobias Smit' },
  { date: '27 okt', time: '14:30', match: 'Heren 4 – Oakfield', timer: 'Niels Vos', scorer: 'Daan Meijer', referees: 'Jeroen Bos · Tim de Boer' },
  { date: '02 nov', time: '20:00', match: 'Heren 2 – Westbridge', timer: 'Bas Mulder', scorer: 'Koen de Jong', referees: 'Ruben Visser · Milan Post' },
  { date: '09 nov', time: '18:30', match: 'Heren 3 – City Ballers', timer: 'Tom Hendriks', scorer: 'Luuk Peters', referees: 'Sven Prins · Joost Blom' },
]
---

<Layout title="Roosters · UBV The Eagles" description="Trainingstijden en wedstrijdtaken van UBV The Eagles.">
  <Header variant="schedule" logoSrc={logo.src} client:load />

  <main>
    <section class="relative overflow-hidden bg-[#101B33] px-5 pb-20 pt-16 text-white sm:px-8 sm:pb-24 sm:pt-20">
      <div class="absolute -right-20 -top-24 size-96 rounded-full border-[70px] border-white/[0.03]"></div>
      <div class="relative mx-auto max-w-[1400px] lg:px-4">
        <p class="section-kicker text-[#FFD400]">Praktische informatie</p>
        <h1 class="font-display mt-4 text-[clamp(4.5rem,11vw,9rem)] font-extrabold uppercase leading-[0.8] tracking-[-0.04em]">Roosters</h1>
        <p class="mt-7 max-w-xl text-sm leading-6 text-white/60">Bekijk wanneer je team traint en wie er bij de komende thuiswedstrijden verantwoordelijk is voor de wedstrijdtaken.</p>
      </div>
    </section>

    <section class="px-5 py-20 sm:px-8 sm:py-28" id="trainingen">
      <div class="mx-auto max-w-[1400px] lg:px-4">
        <div class="mb-10">
          <p class="section-kicker">Wekelijks rooster</p>
          <h2 class="section-title">Training</h2>
        </div>
        <div class="grid gap-px bg-[#101B33]/15 md:grid-cols-2 xl:grid-cols-4">
          {trainings.map((training, index) => (
            <article class={`${index === 0 ? 'bg-[#FFD400]' : 'bg-white'} min-h-64 p-7`}>
              <div class="flex items-start justify-between">
                <span class="font-display text-2xl font-extrabold uppercase">{training.team}</span>
                <span class="size-2 rounded-full bg-[#101B33]"></span>
              </div>
              <div class="mt-7 divide-y divide-[#101B33]/20 border-t border-[#101B33]/20">
                {training.sessions.map((session) => (
                  <div class="py-5 first:pt-5 last:pb-0">
                    <p class="font-display text-2xl font-bold uppercase">{session.day}</p>
                    <p class="mt-1 text-sm font-semibold">{session.time}</p>
                    <p class="mt-3 text-xs leading-5 text-[#101B33]/55">{session.location}</p>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white px-5 py-20 sm:px-8 sm:py-28" id="taken">
      <div class="mx-auto max-w-[1400px] lg:px-4">
        <div class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class="section-kicker">Rondom de wedstrijd</p>
            <h2 class="section-title">Taken</h2>
          </div>
          <p class="max-w-sm text-sm leading-6 text-[#101B33]/55">Kun je niet op jouw ingedeelde moment? Regel dan zelf op tijd een vervanger.</p>
        </div>

        <div class="hidden border-t border-[#101B33]/20 md:block">
          <div class="grid grid-cols-[0.65fr_1.5fr_1.5fr_1.35fr] gap-5 border-b border-[#101B33]/20 py-4 text-[10px] font-extrabold uppercase tracking-[0.14em] text-[#101B33]/45">
            <span>Datum</span><span>Wedstrijd</span><span>Timer / score</span><span>Scheidsrechters</span>
          </div>
          {duties.map((duty) => (
            <article class="grid grid-cols-[0.65fr_1.5fr_1.5fr_1.35fr] items-center gap-5 border-b border-[#101B33]/15 py-6 text-sm">
              <div><p class="font-display text-xl font-bold uppercase">{duty.date}</p><p class="text-xs text-[#101B33]/45">{duty.time}</p></div>
              <p class="font-semibold">{duty.match}</p>
              <p>{duty.timer} · {duty.scorer}</p>
              <p>{duty.referees}</p>
            </article>
          ))}
        </div>

        <div class="grid gap-4 md:hidden">
          {duties.map((duty) => (
            <article class="border border-[#101B33]/15 bg-[#F4F2EC] p-5">
              <div class="flex items-start justify-between gap-4">
                <h3 class="font-display text-2xl font-bold uppercase">{duty.match}</h3>
                <span class="shrink-0 bg-[#FFD400] px-2 py-1 text-[10px] font-extrabold uppercase">{duty.date}</span>
              </div>
              <p class="mt-1 text-xs text-[#101B33]/45">{duty.time}</p>
              <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-[#101B33]/15 pt-4 text-sm">
                <div class="col-span-2"><dt class="text-[9px] font-extrabold uppercase tracking-wider text-[#101B33]/45">Timer / score</dt><dd class="mt-1">{duty.timer} · {duty.scorer}</dd></div>
                <div class="col-span-2"><dt class="text-[9px] font-extrabold uppercase tracking-wider text-[#101B33]/45">Scheidsrechters</dt><dd class="mt-1">{duty.referees}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer variant="schedule" />
</Layout>
