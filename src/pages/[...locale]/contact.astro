---
import type { GetStaticPaths } from "astro"
import MainLayout from "../../layouts/main.astro"
import ArrowUpRight from "../../components/icons/ArrowUpRight.astro"
import VenueMap from "../../components/VenueMap.astro"
import { defaultLocale, getHomeContent, locales, resolveLocale, useTranslations } from "../../i18n"

export const getStaticPaths = (() =>
	locales.map((locale) => ({ params: { locale: locale === defaultLocale ? undefined : locale } }))) satisfies GetStaticPaths

const locale = resolveLocale(Astro.currentLocale)
const t = useTranslations(locale)
const { contact } = await getHomeContent(locale)
const { page, board } = contact

---
<MainLayout title={page.metaTitle} description={page.metaDescription} headerVariant="page" current="contact">
	<main id="main" class="bg-navy pt-32 pb-16 text-white sm:pt-40 sm:pb-24">
		<div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
			<div class="mb-12">
				<h1 class="section-title mt-0 text-white">{page.pageTitle}</h1>
				<p class="mt-5 max-w-xl text-sm leading-6 text-white/70">{page.pageIntro}</p>
			</div>

			<section aria-labelledby="board-title" class="mb-12 border-t border-white/20 pt-8">
				<h2 id="board-title" class="text-xs font-extrabold tracking-label text-white/60 uppercase">{board.title}</h2>
				<p class="mt-3 max-w-xl text-sm leading-6 text-white/70">{board.intro}</p>

				<ul class="mt-6 space-y-2 text-sm leading-6">
					{board.members.map((member) => (
						<li class="flex flex-col sm:flex-row sm:gap-10">
							<span class="sm:w-76"><span class="font-bold">{member.name}</span> – {member.role}</span>
							<a href={`mailto:${member.email}`} class="w-fit text-white underline underline-offset-4 transition hover:text-gold sm:w-68">{member.email}</a>
							{member.phone && <a href={`tel:${member.phone.replace(/-/g, "")}`} class="w-fit text-white transition hover:text-gold">{member.phone}</a>}
						</li>
					))}
				</ul>
				<p class="mt-6 max-w-xl text-sm leading-6 text-white/70">{board.lastMinute}</p>
			</section>

			<div class="grid gap-12 lg:grid-cols-[0.65fr_1.35fr]">
				<div class="grid content-start gap-8 border-t border-white/20 pt-6">
					<div>
						<h2 class="mb-3 text-xs font-extrabold tracking-label text-white/60 uppercase">{contact.postal.title}</h2>
						<address class="text-sm leading-6 not-italic">{contact.postal.lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</address>
					</div>
					<div>
						<h2 class="mb-3 text-xs font-extrabold tracking-label text-white/60 uppercase">{contact.venue.title}</h2>
						<address class="text-sm leading-6 not-italic">{contact.venue.lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</address>
					</div>
				</div>
				<div class="max-w-3xl">
					<VenueMap lon={contact.venue.lon} lat={contact.venue.lat} label={contact.venue.mapTitle} class="border-white/20" />
					<a
						href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.venue.mapQuery)}`}
						target="_blank"
						rel="noopener"
						class="link-arrow mt-5"
					>{contact.venue.mapLinkLabel} <span class="sr-only">{t("link.newTab")}</span> <ArrowUpRight /></a>
				</div>
			</div>
		</div>
	</main>
</MainLayout>
