---
import MainLayout from "../../layouts/main.astro"
import MatchList from "../../components/MatchList.astro"
import ResultRow from "../../components/ResultRow.astro"
import ResultRowSkeleton from "../../components/ResultRowSkeleton.astro"
import { fetchClubLogos } from "../../lib/clubs"
import { MATCH_LIST_PAGE_SIZE } from "../../lib/list-controls"
import { BLANK_RESULT } from "../../lib/matches"
import { getHomeContent, getOutcomeLabels, localeStaticPaths, resolveLocale, useTranslations } from "../../i18n"

export const getStaticPaths = localeStaticPaths

const locale = resolveLocale(Astro.currentLocale)
const t = useTranslations(locale)
const { results } = await getHomeContent(locale)
const page = results.page

// Results are fetched in the browser (always up to date); skeletons show while they load.
const clubLogos = await fetchClubLogos()
---
<MainLayout title={page.metaTitle} description={page.metaDescription} headerVariant="page" current="results">
	<main id="main" class="bg-navy pt-32 pb-16 text-white sm:pt-40 sm:pb-24">
		<div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
			<div class="mb-12">
				<h1 class="section-title mt-0 text-white">{page.pageTitle}</h1>
				<p class="mt-5 text-sm leading-6 text-white/70">{page.pageIntro}</p>
			</div>

			<MatchList locale={locale} emptyMessage={t("matches.noResults")}>
				{Array.from({ length: MATCH_LIST_PAGE_SIZE }, () => <ResultRowSkeleton />)}
				<template slot="template" data-item-template data-outcome-labels={JSON.stringify(getOutcomeLabels(t))} data-club-logos={JSON.stringify(clubLogos)}>
					<ResultRow result={BLANK_RESULT} locale={locale} />
				</template>
			</MatchList>
		</div>
	</main>
</MainLayout>

<script>
	import type { ClubLogos } from "../../lib/clubs"
	import { $, readJson } from "../../lib/dom"
	import { loadMatchList } from "../../lib/list-controls"
	import { selectResults } from "../../lib/matches"
	import { renderResult } from "../../lib/render-match"

	const root = $(document, "[data-match-list]")
	const template = $<HTMLTemplateElement>(root, "[data-item-template]")
	const outcomeLabels = readJson<Record<string, string>>(template, "outcomeLabels")
	const clubLogos = readJson<ClubLogos>(template, "clubLogos")

	loadMatchList(root, (matches) => selectResults(matches), (match) => renderResult(template, outcomeLabels, match, clubLogos))
</script>
