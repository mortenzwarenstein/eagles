---
import logo from '../assets/ubv-the-eagles-logo.png'

export interface Result {
  competition: string
  date: string
  home: string
  away: string
  homeScore: number
  awayScore: number
  won: boolean
}

interface Props {
  result: Result
}

const { result } = Astro.props
const awayInitials = result.away
  .split(' ')
  .map((word) => word[0])
  .join('')
  .slice(0, 2)
---

<article class="group flex h-full min-w-[285px] flex-1 flex-col border border-white/15 bg-white/[0.06] p-5 transition hover:bg-white/[0.1]">
  <div class="mb-8 flex items-start justify-between gap-4 text-[11px] font-bold uppercase tracking-[0.14em] text-white/55">
    <span>{result.competition}</span>
    <span>{result.date}</span>
  </div>
  <div class="mt-auto space-y-3">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="flex size-7 items-center justify-center rounded-full bg-[#FFD400] p-1">
          <img src={logo.src} alt="" class="size-full object-contain" />
        </span>
        <span class="font-semibold">{result.home}</span>
      </div>
      <span class="font-score text-3xl">{result.homeScore}</span>
    </div>
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="flex size-7 items-center justify-center rounded-full border border-white/25 text-[9px] font-bold text-white/60">{awayInitials}</span>
        <span class="font-semibold text-white/75">{result.away}</span>
      </div>
      <span class="font-score text-3xl text-white/65">{result.awayScore}</span>
    </div>
  </div>
  <span
    class:list={[
      'mt-5 w-fit px-2 py-1 text-[10px] font-extrabold uppercase tracking-wider',
      result.won ? 'bg-[#FFD400] text-[#101B33]' : 'bg-white/15 text-white',
    ]}
  >
    {result.won ? 'Winst' : 'Gelijk'}
  </span>
</article>
