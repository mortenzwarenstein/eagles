---
import { useTranslations, type Locale } from "../i18n"

interface Props {
    locale: Locale
}

const t = useTranslations(Astro.props.locale)
---
<footer class="bg-navy-deep px-5 py-8 text-sm text-white/70 sm:px-8 lg:px-12">
    <p class="mx-auto max-w-350">© {new Date().getFullYear()} UBV The Eagles. {t("footer.rights")}.</p>
</footer>
