---
import TeamBadge from "./TeamBadge.astro"

import { OUTCOME_CLASSES, shortenName, type Match } from "../lib/matches"
import { useTranslations, type Locale } from "../i18n"

interface Props {
	result: Match
	locale: Locale
}

const { result, locale } = Astro.props
const t = useTranslations(locale)

const teams = [
	{ name: result.home, score: result.homeScore, isEagles: result.homeIsUs },
	{ name: result.away, score: result.awayScore, isEagles: result.awayIsUs },
].map((team) => ({ ...team, shortName: shortenName(team.name, 32) }))

// Full-width variant of ResultCard: same data-* hooks, so lib/render-match.ts fills both.
---
<li class="grid grid-cols-[4.5rem_1fr_auto] items-center gap-x-4 border border-white/15 bg-white/6 p-5 sm:grid-cols-[9rem_1fr_auto] sm:gap-x-8">
	<span data-date class="text-xs font-bold tracking-label text-white/55 uppercase">{result.dateLabel}</span>
	<div class="min-w-0 space-y-2">
		{teams.map((team) => (
			<div data-team class="flex items-center justify-between gap-4">
				<div class="flex min-w-0 items-center gap-3">
					<TeamBadge name={team.name} isEagles={team.isEagles} />
					<span data-name title={team.name} class:list={["min-w-0 truncate font-semibold", !team.isEagles && "text-white/75"]}>{team.shortName}</span>
				</div>
				<span data-score class:list={["font-score text-2xl", !team.isEagles && "text-white/65"]}>{team.score}</span>
			</div>
		))}
	</div>
	{result.outcome && (
		<span data-outcome class:list={["w-16 px-2 py-1 text-center text-xs font-extrabold tracking-wider uppercase sm:w-20", OUTCOME_CLASSES[result.outcome]]}>
			{t(`outcome.${result.outcome}`)}
		</span>
	)}
</li>
