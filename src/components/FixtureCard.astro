---
import { shortenName } from "../lib/matches"

export interface Fixture {
	day: string
	month: string
	time: string
	home: string
	away: string
	venue: string
}

interface Props {
	fixture: Fixture
}

const { fixture } = Astro.props

// One line per team; names that still don't fit are shortened (keeping the team number).
const teams = [fixture.home, fixture.away].map((name) => ({ name, short: shortenName(name, 28) }))
---
<article class="grid grid-cols-[58px_1fr_auto] items-center gap-4 border-b border-navy/20 py-6 sm:grid-cols-[70px_1fr_1fr_auto] sm:gap-7">
	<div class="border-r border-navy/15">
		<span class="block font-score text-4xl leading-none">{fixture.day}</span>
		<span class="text-[10px] font-extrabold tracking-[0.16em] text-navy/50">{fixture.month}</span>
	</div>
	<div class="min-w-0">
		{teams.map((team, i) => (
			<p
				title={team.name}
				class:list={["truncate font-display text-xl leading-tight font-bold uppercase sm:text-2xl", i === 1 && "text-navy/60"]}
			>
				{team.short}
			</p>
		))}
	</div>
	<div class="hidden sm:block">
		<p class="text-xs text-navy/50">{fixture.venue}</p>
	</div>
	<div class="text-right">
		<span class="font-score text-xl">{fixture.time}</span>
	</div>
</article>
