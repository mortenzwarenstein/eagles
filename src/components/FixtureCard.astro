---
import { shortenName } from "../lib/matches"

export interface Fixture {
	time: string
	home: string
	away: string
	venue: string
}

interface Props {
	fixture: Fixture
}

const { fixture } = Astro.props

// One line per team; names that still don't fit are shortened (keeping the team number).
const teams = [fixture.home, fixture.away].map((name) => ({ name, short: shortenName(name, 28) }))
---
<article class="grid grid-cols-[3.25rem_1fr] items-center gap-x-4 py-4 pr-4 pl-4 first:pt-0 last:pb-0 sm:grid-cols-[3.25rem_minmax(0,1.8fr)_minmax(0,1fr)] sm:gap-x-7 sm:pr-5">
	<span class="font-score text-2xl leading-none font-bold">{fixture.time}</span>
	<div class="min-w-0">
		{teams.map((team, i) => (
			<p
				title={team.name}
				class:list={["truncate font-display text-xl leading-tight font-bold uppercase sm:text-2xl", i === 1 && "text-navy/60"]}
			>
				{team.short}
			</p>
		))}
	</div>
	<p class="hidden text-xs text-navy/50 sm:block">{fixture.venue}</p>
</article>
