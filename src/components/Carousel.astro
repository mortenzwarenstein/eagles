---
import ArrowLeft from "./icons/ArrowLeft.astro"
import ArrowRight from "./icons/ArrowRight.astro"

interface Props {
	label: string
	prevLabel: string
	nextLabel: string
}

const { label, prevLabel, nextLabel } = Astro.props
const buttonClass =
	"flex size-11 items-center justify-center border border-white/25 text-white transition hover:bg-gold hover:text-navy disabled:pointer-events-none disabled:opacity-30"
---
<!--
	Wrap each slide in <li class="carousel-slide ..."> and size it with a basis-* class
	(e.g. basis-full lg:basis-[calc((100%-2rem)/3)] for 3 visible slides on desktop).
-->
<div data-carousel>
	<ul data-carousel-track tabindex="0" aria-label={label} class="flex cursor-grab select-none snap-x snap-mandatory gap-4 overflow-x-auto motion-safe:scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
		<slot />
	</ul>
	<div class="mt-6 flex justify-end gap-2">
		<button type="button" data-carousel-prev aria-label={prevLabel} class={buttonClass}><ArrowLeft /></button>
		<button type="button" data-carousel-next aria-label={nextLabel} class={buttonClass}><ArrowRight /></button>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
		const track = root.querySelector<HTMLElement>("[data-carousel-track]")!
		const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]")!
		const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]")!

		// Distance of one slide, including the gap between slides.
		const step = () => {
			const [first, second] = Array.from(track.children) as HTMLElement[]
			return second ? second.offsetLeft - first.offsetLeft : first.offsetWidth
		}
		const update = () => {
			const max = track.scrollWidth - track.clientWidth - 1
			prev.disabled = track.scrollLeft <= 0
			next.disabled = track.scrollLeft >= max
			// Nothing to scroll: hide the controls altogether.
			prev.parentElement!.hidden = max <= 0
		}

		// Touch devices scroll (and snap) natively. Mouse users get drag-to-scroll.
		let startX = 0
		let startScroll = 0
		let dragging = false
		let moved = false

		track.addEventListener("pointerdown", (e) => {
			if (e.pointerType !== "mouse" || e.button !== 0) return
			dragging = true
			moved = false
			startX = e.clientX
			startScroll = track.scrollLeft
			// Disable snapping and smooth scrolling while dragging so the track follows the pointer 1:1.
			track.style.scrollSnapType = "none"
			track.style.scrollBehavior = "auto"
			track.classList.replace("cursor-grab", "cursor-grabbing")
			track.setPointerCapture(e.pointerId)
		})
		track.addEventListener("pointermove", (e) => {
			if (!dragging) return
			const dx = e.clientX - startX
			if (Math.abs(dx) > 4) moved = true
			track.scrollLeft = startScroll - dx
		})
		const endDrag = () => {
			if (!dragging) return
			dragging = false
			track.classList.replace("cursor-grabbing", "cursor-grab")
			// Restore snapping: the browser settles on the nearest slide.
			track.style.scrollSnapType = ""
			track.style.scrollBehavior = ""
		}
		track.addEventListener("pointerup", endDrag)
		track.addEventListener("pointercancel", endDrag)
		// A drag must not count as a click on a link inside a slide, and images must not be ghost-dragged.
		track.addEventListener("click", (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false } }, true)
		track.addEventListener("dragstart", (e) => e.preventDefault())

		prev.addEventListener("click", () => track.scrollBy({ left: -step() }))
		next.addEventListener("click", () => track.scrollBy({ left: step() }))
		track.addEventListener("scroll", update, { passive: true })
		window.addEventListener("resize", update)
		// Slides may be replaced after load (e.g. refreshed client-side).
		new MutationObserver(update).observe(track, { childList: true })
		update()
	})
</script>
