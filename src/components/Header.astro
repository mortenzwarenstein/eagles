---
import Logo from "../assets/images/eag_logo.png"

import { getRelativeLocaleUrl } from "astro:i18n"
import { locales, localizedPathname, useTranslations, type Locale } from "../i18n"

interface Props {
    variant?: "home" | "schedule"
    locale: Locale
}

const { variant = "home", locale } = Astro.props
const t = useTranslations(locale)
const isHome = variant === "home"

const homeUrl = getRelativeLocaleUrl(locale)
const prefix = isHome ? "" : homeUrl
const navItems = [
    { label: t("nav.teams"), href: `${prefix}#teams` },
    { label: t("nav.fixtures"), href: `${prefix}#fixtures` },
    { label: t("nav.results"), href: `${prefix}#results` },
    { label: t("nav.media"), href: `${prefix}#media` },
    ...(isHome ? [{ label: t("nav.schedules"), href: getRelativeLocaleUrl(locale, "roosters") }] : []),
]
const otherLocales = locales
    .filter((l) => l !== locale)
    .map((l) => ({ code: l, label: l.toUpperCase(), name: useTranslations(l)("locale.name"), href: localizedPathname(Astro.url.pathname, l) }))
---
<header
    id="site-header"
    class:list={[
        "z-30 text-white backdrop-blur-md transition-colors duration-300",
        isHome
            ? "fixed inset-x-0 top-0 border-b border-white/20 bg-white/10 data-scrolled:bg-navy/90"
            : "sticky top-0 bg-navy/80",
    ]}
>
    <div class="mx-auto flex h-20 max-w-350 items-center justify-between px-5 sm:px-8 lg:px-12">
        <a href={isHome ? "#top" : homeUrl} class="flex items-center gap-3" aria-label={t("header.homeLabel")}>
            <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-white p-2">
                <img src={Logo.src} alt={t("header.logoAlt")} class="size-full object-contain" />
            </span>
            <span class="font-display text-xl leading-none font-bold tracking-[0.06em] text-gold uppercase">
                UBV<br />The Eagles
            </span>
        </a>

        <nav
            class:list={["hidden items-center md:flex", isHome ? "gap-9" : "gap-8"]}
            aria-label={t("nav.main")}
        >
            {navItems.map((item) => (
                <a
                    href={item.href}
                    class:list={[
                        "text-xs font-bold tracking-[0.15em] uppercase transition hover:text-gold",
                        isHome ? "text-white/80" : "text-white/70",
                    ]}
                >
                    {item.label}
                </a>
            ))}
            {!isHome && (
                <span class="border-b border-gold pb-1 text-xs font-bold tracking-[0.15em] text-gold uppercase">{t("nav.schedules")}</span>
            )}
            {otherLocales.map((l) => (
                <a
                    href={l.href}
                    hreflang={l.code}
                    lang={l.code}
                    title={l.name}
                    aria-label={`${t("nav.language")}: ${l.name}`}
                    class="border border-white/30 px-2 py-1 text-xs font-bold tracking-[0.15em] text-white/80 transition hover:border-gold hover:text-gold"
                >
                    {l.label}
                </a>
            ))}
        </nav>

        <button
            type="button"
            id="nav-toggle"
            class="flex size-10 items-center justify-center border border-white/30 md:hidden"
            aria-label={t("nav.toggle")}
            aria-expanded="false"
            aria-controls="mobile-nav"
        >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-icon="open">
                <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <svg class="hidden size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-icon="close">
                <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <nav
        id="mobile-nav"
        class:list={["hidden border-t bg-navy px-5 py-6 md:hidden", isHome ? "border-white/20" : "border-white/15"]}
        aria-label={t("nav.mobile")}
    >
        <div class="flex flex-col gap-5">
            {navItems.map((item) => (
                <a href={item.href} class="font-display text-2xl font-bold text-white uppercase">{item.label}</a>
            ))}
            {!isHome && <span class="font-display text-2xl font-bold text-gold uppercase">{t("nav.schedules")}</span>}
            {otherLocales.map((l) => (
                <a href={l.href} hreflang={l.code} lang={l.code} class="font-display text-2xl font-bold text-gold uppercase">{l.name}</a>
            ))}
        </div>
    </nav>
</header>

<script>
    const header = document.querySelector<HTMLElement>("#site-header")
    const syncScrolled = () => header?.toggleAttribute("data-scrolled", window.scrollY > 8)
    syncScrolled()
    window.addEventListener("scroll", syncScrolled, { passive: true })

    const toggle = document.querySelector<HTMLButtonElement>("#nav-toggle")
    const mobileNav = document.querySelector<HTMLElement>("#mobile-nav")

    function setOpen(open: boolean) {
        if (!toggle || !mobileNav) return
        toggle.setAttribute("aria-expanded", String(open))
        mobileNav.classList.toggle("hidden", !open)
        toggle.querySelector("[data-icon=open]")?.classList.toggle("hidden", open)
        toggle.querySelector("[data-icon=close]")?.classList.toggle("hidden", !open)
    }

    toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"))
    mobileNav?.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) setOpen(false)
    })
</script>
