---
import Logo from "../assets/images/eag_logo.png"

import { getRelativeLocaleUrl } from "astro:i18n"
import { locales, localizedPathname, useTranslations, type Locale } from "../i18n"

interface Props {
    variant?: "home" | "page"
    /** Nav item that represents the current page */
    current?: "home" | "join"
    locale: Locale
}

const { variant = "home", current, locale } = Astro.props
const t = useTranslations(locale)
const isHome = variant === "home"

const homeUrl = getRelativeLocaleUrl(locale)
const prefix = isHome ? "" : homeUrl
const navItems = [
    { label: t("nav.home"), href: homeUrl, current: current === "home", section: "home" },
    { label: t("nav.results"), href: `${prefix}#results`, current: false, section: "results" },
    { label: t("nav.fixtures"), href: `${prefix}#fixtures`, current: false, section: "fixtures" },
    current === "join"
        ? { label: t("nav.join"), href: getRelativeLocaleUrl(locale, "inschrijven"), current: true, section: "join" }
        : { label: t("nav.join"), href: `${prefix}#join`, current: false, section: "join" },
    { label: t("nav.contact"), href: `${prefix}#contact`, current: false, section: "contact" },
]
const otherLocales = locales
    .filter((l) => l !== locale)
    .map((l) => ({ code: l, label: l.toUpperCase(), name: useTranslations(l)("locale.name"), href: localizedPathname(Astro.url.pathname, l) }))
---
<header
    id="site-header"
    class:list={[
        "fixed inset-x-0 top-0 z-30 border-b border-white/20 bg-white/10 text-white backdrop-blur-md transition-colors duration-300 data-scrolled:bg-navy/90",
    ]}
>
    <div class="mx-auto flex h-20 max-w-350 items-center justify-between px-5 sm:px-8 lg:px-12">
        <a href={isHome ? "#main" : homeUrl} class="flex items-center gap-3" aria-label={t("header.homeLabel")}>
            <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-white p-2">
                <img src={Logo.src} alt={t("header.logoAlt")} class="size-full object-contain" />
            </span>
            <span class="font-display text-xl leading-none font-bold tracking-[0.06em] text-gold uppercase">
                UBV<br />The Eagles
            </span>
        </a>

        <nav
            class="hidden items-center gap-9 md:flex"
            aria-label={t("nav.main")}
        >
            {navItems.map((item) => (
                <a
                    href={item.href}
                    data-nav-section={isHome ? item.section : undefined}
                    aria-current={item.current ? "page" : undefined}
                    class="border-b border-transparent py-2 text-xs font-bold tracking-[0.15em] text-white/80 uppercase transition hover:text-gold aria-[current=page]:border-gold aria-[current=page]:text-gold"
                >
                    {item.label}
                </a>
            ))}
            {otherLocales.map((l) => (
                <a
                    href={l.href}
                    hreflang={l.code}
                    lang={l.code}
                    title={l.name}
                    aria-label={`${l.label} – ${l.name}`}
                    class="border border-white/30 px-2 py-2 text-xs font-bold tracking-[0.15em] text-white/80 transition hover:border-gold hover:text-gold"
                >
                    {l.label}
                </a>
            ))}
        </nav>

        <button
            type="button"
            id="nav-toggle"
            class="flex size-10 items-center justify-center border border-white/30 md:hidden"
            aria-label={t("nav.toggle")}
            aria-expanded="false"
            aria-controls="mobile-nav"
        >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-icon="open">
                <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <svg class="hidden size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-icon="close">
                <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <nav
        id="mobile-nav"
        class="hidden border-t border-white/20 bg-navy px-5 py-6 md:hidden"
        aria-label={t("nav.mobile")}
    >
        <div class="flex flex-col gap-5">
            {navItems.map((item) => (
                <a href={item.href} data-nav-section={isHome ? item.section : undefined} aria-current={item.current ? "page" : undefined} class="w-fit border-b-2 border-transparent font-display text-2xl font-bold text-white uppercase aria-[current=page]:border-gold aria-[current=page]:text-gold">{item.label}</a>
            ))}
            {otherLocales.map((l) => (
                <a href={l.href} hreflang={l.code} lang={l.code} class="font-display text-2xl font-bold text-white/60 uppercase">{l.name}</a>
            ))}
        </div>
    </nav>
</header>

<script>
    const header = document.querySelector<HTMLElement>("#site-header")
    const syncScrolled = () => header?.toggleAttribute("data-scrolled", window.scrollY > 8)
    syncScrolled()
    window.addEventListener("scroll", syncScrolled, { passive: true })

    // Scroll spy: mark the nav link of the section currently in view (home page only)
    const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-section]")
    const sections = [...new Set([...navLinks].map((a) => a.dataset.navSection!))]
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null)
    const syncCurrent = () => {
        const line = (header?.offsetHeight ?? 80) + 40
        const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2
        let active = "home"
        for (const el of sections) if (el.getBoundingClientRect().top <= line) active = el.id
        if (atBottom && sections.length) active = sections[sections.length - 1].id
        for (const a of navLinks) {
            if (a.dataset.navSection === active) a.setAttribute("aria-current", "page")
            else a.removeAttribute("aria-current")
        }
        const hash = active === "home" ? "" : `#${active}`
        if (location.hash !== hash) {
            history.replaceState(null, "", location.pathname + location.search + hash)
        }
    }
    if (navLinks.length) {
        syncCurrent()
        window.addEventListener("scroll", syncCurrent, { passive: true })
        window.addEventListener("resize", syncCurrent)
    }

    const toggle = document.querySelector<HTMLButtonElement>("#nav-toggle")
    const mobileNav = document.querySelector<HTMLElement>("#mobile-nav")

    function setOpen(open: boolean) {
        if (!toggle || !mobileNav) return
        toggle.setAttribute("aria-expanded", String(open))
        mobileNav.classList.toggle("hidden", !open)
        toggle.querySelector("[data-icon=open]")?.classList.toggle("hidden", open)
        toggle.querySelector("[data-icon=close]")?.classList.toggle("hidden", !open)
    }

    toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"))
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
            setOpen(false)
            toggle.focus()
        }
    })
    mobileNav?.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) setOpen(false)
    })
</script>
